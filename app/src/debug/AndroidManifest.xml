<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only (DEV-009). Release builds must not contain this activity (scripts/check-release-apk.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- DEV-012 spike only (ADR-0002): lets the Build.getSerial() fallback be tested on the iMin device. Not approved
         for release (PRD §12.3, A-02, R-3); the release manifest gets it only if the PO approves ADR-0002. Grant it
         with `adb shell pm grant com.hitachi.kiosk android.permission.READ_PHONE_STATE`, or as device owner with
         setPermissionGrantState. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 17 blocks apps that target it from private addresses such as the emulator host 10.0.2.2 (the Prism mock
         server of Developer options). Debug and releaseLocal only; release never talks to a local network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application>
        <activity
            android:name="com.hitachi.kiosk.debug.DeveloperOptionsActivity"
            android:exported="false"
            android:label="@string/dev_options_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kiosk"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
