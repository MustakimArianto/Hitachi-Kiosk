<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint for the verify gate (NFR-008, NFR-011). warningsAsErrors is on in build-logic. -->
<lint>
    <!-- Version freshness is reviewed with ./gradlew dependencyUpdates at each milestone start
         (technology-stack §9), not on every build. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- Hard rules from the PRD: no hardcoded UI text, accessible content descriptions. -->
    <issue id="HardcodedText" severity="error" />
    <issue id="ContentDescription" severity="error" />
</lint>
